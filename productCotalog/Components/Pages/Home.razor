@page "/"
@using productCotalog.Components.Shared
@using productCotalog.Services
@using productCotalog.Models
@using productCotalog.Interfaces
@inject ProductService ProductService

<PageTitle>Products</PageTitle>

<div>
    <div class="d-flex align-items-start" style="gap: clamp(0.5rem,2vw,2rem);">
        <SearchInput />
        <Select Options="@Categories" SelectedLabel="Все категории" />
   </div>
    <div class="row row-cols-4 gap-4 justify-content-center">
        @foreach (var product in products)
        {
            <ProductCard product="@product" />
        }
    </div>
    <Pagination currentPage="@currentPage" totalPages="@totalPages" />

</div>


@code {
    private int currentPage = 1;
    private int totalPages = 7;
    private List<ProductModel> products = new();

    private List<IDropdownOptions> Categories = new();

    protected override void OnInitialized()
    {
        products = ProductService.GetProducts(
            searchTerm: null,
            category: null,
            sortOrder: SortModelEnum.ASC,
            pageNumber: 1,
            pageSize: 10);

        Categories = ProductService.GetCategories().Cast<IDropdownOptions>()
            .ToList();
    }
}