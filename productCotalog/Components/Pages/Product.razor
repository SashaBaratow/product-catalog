@page "/"
@using productCotalog.Components.Shared
@using productCotalog.Services
@using productCotalog.Store
@using productCotalog.Models
@using productCotalog.Interfaces
@inject ProductService ProductService
@inject CartService CartService
@rendermode InteractiveServer

<PageTitle>Products</PageTitle>

<div>
    <div class="d-flex align-items-start" style="gap: clamp(0.5rem,2vw,2rem);">
        <SearchInput OnSearch="HandleSearch" Value="@configList.SearchTerm" />
        <Select Options="@PriceSortOrders" SelectedLabel="Все" TValue="PriceModelEnum" OnSelect="HandlePriceSort"/>
        <Select Options="@Categories" SelectedLabel="Все категории" TValue="CategoryEnum" OnSelect="HandleCategoryFilter" />
   </div>
    <div class="row row-cols-4 gap-4 justify-content-center">
        @if (products.Any())
        {
            @foreach (var product in products)
            {
                <ProductCard product="@product" onAddToCart="HandleAddToCart" />
            }
        }
        else
        {
            <p class="text-center">В данный момент нет продуктов.</p>
        }
    </div>
    <Pagination currentPage="@configList.PageNumber" totalPages="@configList.TotalPages" onChange="HandlePageChange" />

</div>


@code {
    private ListConfigModel configList;
    private List<ProductModel> products = new();

    private List<IDropdownOptions> Categories = new();
    private List<IDropdownOptions> PriceSortOrders = new();

   
    private void LoadProducts()
    {
        products = ProductService.GetProducts(
            searchTerm: configList.SearchTerm ?? "",
            category: configList.Category,
            sortOrder: configList.SortOrder,
            pageNumber: configList.PageNumber,
            pageSize: configList.PageSize); 
    }
    private void HandleAddToCart(ProductModel product)
    {
        CartService.AddCart(product);
    }
    private void HandlePriceSort(PriceModelEnum? sortOrder)
    {
        configList.SortOrder = sortOrder;
        configList.PageNumber = 1;
        LoadProducts();
    }
    private void HandleCategoryFilter(CategoryEnum? category)
    {
        configList.Category = category;
        configList.PageNumber = 1;
        LoadProducts();
    }


    private void HandleSearch(string term)
    {
        configList.SearchTerm = term;
        configList.PageNumber = 1;        
        LoadProducts();
    }
    private void HandlePageChange(int pageNumber)
    {
        configList.PageNumber = pageNumber;
        LoadProducts();
    }

    protected override void OnInitialized()
    {
        configList = ProductService.GetConfigList();
        PriceSortOrders = ProductService.GetPriceSortOptions().Cast<IDropdownOptions>()
            .ToList();
        Categories = ProductService.GetCategories().Cast<IDropdownOptions>()
            .ToList();
        LoadProducts();
    }
}