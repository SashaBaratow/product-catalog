<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid container">
        <a class="navbar-brand" href="#">Navbar</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                @foreach (var item in navMenuItems)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@item.path">@item.label</NavLink>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code{
    private class NavMenuItem
    {
        public string? path { get; set; }
        public int? id { get; set; }
        public string? label { get; set; }
    }

    private NavMenuItem[] navMenuItems = [
         new NavMenuItem { id = 1, path = "", label = "Products" },
         new NavMenuItem { id = 2, path = "cart", label = "Cart"  }
    ];

}